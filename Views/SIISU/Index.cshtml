@using SSP.ViewModels;
@model VmSoliSiisu;
@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssSiisu.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Scripts/jsSiisu.js" asp-append-version="true"></script>
}

<div class="container-fluid col-12 col-md-8 col-lg-7 col-xl-5 text-start">
    <br /><br />
    <div class="d-flex gap-3 align-items-center" style="min-height: 3rem;">
        <a class="btn btn-secondary d-flex p-2" asp-controller="Seleccion" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h4 class="text-start m-0">Solicitud de Permisos al Subsistema de Recursos Humanos (SIISU)</h4>
    </div>
    <br />
    <form id="form-solicitud" class="d-flex flex-column gap-3 needs-validation" method="post" asp-action="DescargarSolicitud" novalidate>
        @Html.AntiForgeryToken()
        <ul class="nav nav-pills nav-fill gap-1" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="custom-tab nav-link shadow-sm active" id="pills-datos-tab" data-bs-toggle="pill" data-bs-target="#pills-datos" type="button" role="tab" aria-controls="pills-datos" aria-selected="true">
                    Datos del usuario
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="custom-tab nav-link shadow-sm" id="pills-permisos-tab" data-bs-toggle="pill" data-bs-target="#pills-permisos" type="button" role="tab" aria-controls="pills-permisos" aria-selected="false">
                    Permisos
                </button>
            </li>
        </ul>
        <div class="tab-content" id="pills-tabContent">
            @* Entidad Académica o Dependencia y Empleado autorizado *@
            <div class="tab-pane fade show active" id="pills-datos" role="tabpanel" aria-labelledby="pills-datos-tab" tabindex="0">
                <div class="card bg-white border shadow rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold">Entidad Académica o Dependencia</h6>
                        <div id="info-basica" class="d-flex flex-column gap-1 mt-3">
                            <div class="d-flex">
                                <label asp-for="NEntidadClave" class="col-4 col-form-label">Clave</label>
                                <div class="col-8">
                                    <input asp-for="NEntidadClave" type="number" class="form-control bg-transparent" placeholder="123456789" required>
                                    <span asp-validation-for="NEntidadClave" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <label asp-for="SEntidadNombre" class="col-4 col-form-label">Nombre</label>
                                <div class="col-8 position-relative">
                                    <input asp-for="SEntidadNombre" type="text" class="form-control bg-transparent" placeholder="Dependencia" autocomplete="off" required>
                                    <span asp-validation-for="SEntidadNombre" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <label asp-for="SRegion" class="col-4 col-form-label">Región</label>
                                <div class="col-8 position-relative">
                                    <input asp-for="SRegion" type="text" class="form-control bg-transparent" placeholder="Región" autocomplete="off" required>
                                    <span asp-validation-for="SRegion" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h6 class="fw-semibold">Empleado autorizado</h6>
                        <div id="info-basica" class="d-flex flex-column gap-1">
                            <div class="d-flex">
                                <label asp-for="NNoPersonal" class="col-4 col-form-label">Núm. de Personal</label>
                                <div class="col-8">
                                    <input asp-for="NNoPersonal" type="number" class="form-control bg-transparent" placeholder="61399" required>
                                    <span asp-validation-for="NNoPersonal" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <label asp-for="SNombre" class="col-4 col-form-label">Nombre</label>
                                <div class="col-8">
                                    <input asp-for="SNombre" type="text" class="form-control bg-transparent" placeholder="Angel Guzman" required>
                                    <span asp-validation-for="SNombre" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <label asp-for="NClvUsuario" class="col-4 col-form-label">Usuario</label>
                                <div class="col-8">
                                    <input asp-for="NClvUsuario" type="number" class="form-control bg-transparent" placeholder="123456" required>
                                    <span asp-validation-for="NClvUsuario" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <label asp-for="SPerfil" class="col-4 col-form-label">Perfil</label>
                                <div class="col-8">
                                    <select asp-for="SPerfil"
                                            class="form-control bg-transparent"
                                            asp-items="Html.GetEnumSelectList<SiisuPerfil>()"
                                            required>
                                    </select>
                                    <span asp-validation-for="SPerfil" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Permisos -->
            <div class="tab-pane fade" id="pills-permisos" role="tabpanel" aria-labelledby="pills-permisos-tab" tabindex="0">
                <div class="card bg-white border shadow rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold">Tipo de Movimiento</h6>
                        <div class="d-flex flex-fill gap-3 mt-3 justify-content-around">
                            <div class="form-check">
                                <input asp-for="STipoMovimiento" id="alta" class="form-check-input" type="radio" value="A" checked>
                                <label for="alta" class="form-check-label">Alta</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="STipoMovimiento" id="modificacion" class="form-check-input" type="radio" value="M">
                                <label for="modificacion" class="form-check-label">Modificación</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="STipoMovimiento" id="baja" class="form-check-input" type="radio" value="B">
                                <label for="baja" class="form-check-label">Baja</label>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div id="info-basica" class="d-flex flex-column gap-1">
                            <div class="d-flex">
                                <label asp-for="NClaveDependencia" class="col-4 col-form-label">Clave Dependencia</label>
                                <div class="col-8">
                                    <input asp-for="NClaveDependencia" type="number" class="form-control bg-transparent" placeholder="Dependencia" required>
                                    <span asp-validation-for="NClaveDependencia" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <label asp-for="NClavePrograma" class="col-4 col-form-label">Clave de Programa</label>
                                <div class="col-8">
                                    <input asp-for="NClavePrograma" type="number" class="form-control bg-transparent" placeholder="Programa" required>
                                    <span asp-validation-for="NClavePrograma" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <label asp-for="STipoPermiso" class="col-4 col-form-label">Tipo de permiso</label>
                                <div class="col-8">
                                    <select asp-for="STipoPermiso"
                                            class="form-control bg-transparent"
                                            asp-items="Html.GetEnumSelectList<SiisuPermiso>()"
                                            required>
                                    </select>
                                    <span asp-validation-for="STipoPermiso" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-white border shadow rounded-4 mb-4">
            <div class="card-body d-flex gap-2 justify-content-end p-4">
                <button id="btn-descargar-solicitud" type="submit" class="btn btn-success w-auto" disabled>
                    <i class="fa-solid fa-file-excel"></i> Descargar Excel
                </button>
                @* <button type="submit" name="tipoDescarga" value="pdf" class="btn btn-danger w-auto">
                    <i class="fas fa-file-pdf"></i> Descargar PDF
                </button>
                <button type="submit" name="tipoDescarga" value="excel" class="btn btn-success w-auto">
                    <i class="fa-solid fa-file-excel"></i> Descargar Excel
                </button> *@
            </div>
        </div>
    </form>
</div>
