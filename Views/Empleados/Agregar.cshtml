@using SSP.Models;
@model MoEmpleado
@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssEmpleado.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/Scripts/jsAgregarEmpleado.js" asp-append-version="true"></script>
}

<div class="container-fluid col-12 col-md-10 col-lg-8 col-xxl-6 text-start">
    <br /><br />
    <div class="d-flex gap-3 align-items-center" style="min-height: 3rem;">
        <a class="btn btn-secondary d-flex p-2" asp-controller="Empleados" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h4 class="text-start m-0">Agregar Empleado</h4>
    </div>
    <br />
    
    <div class="mb-3 position-relative">
        <label for="buscador-usuarios" class="form-label fw-semibold">Buscar Usuario Existente</label>
        <input type="text" id="buscador-usuarios" class="form-control" placeholder="Escribe un nombre o usuario..." autocomplete="off" />
        <div id="resultados-busqueda" class="dropdown-menu w-100 bg-white border shadow"></div>
    </div>

    <form method="post" asp-action="Agregar" class="needs-validation" novalidate>
        
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="card shadow border-0 rounded-3">
            <div class="card-body p-4">

                <div class="mb-3">
                    <label asp-for="NNoPersonal" class="form-label">Número de Personal</label>
                    <input asp-for="NNoPersonal" type="number" class="form-control" placeholder="12345" required disabled />
                    <span asp-validation-for="NNoPersonal" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SUsuario" class="form-label">Nombre de Usuario (Login)</label>
                    <input asp-for="SUsuario" class="form-control" placeholder="ej. jguzman" required disabled />
                    <span asp-validation-for="SUsuario" class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold">Permisos y Estado</h5>

                <div class="form-check form-switch mb-2">
                    <input asp-for="BAdmin" type="checkbox" class="form-check-input cursor-pointer" />
                    <label asp-for="BAdmin" class="form-check-label cursor-pointer">Administrador</label>
                </div>
                
                <div class="form-check form-switch mb-2">
                    <input asp-for="BSprfm" type="checkbox" class="form-check-input cursor-pointer" />
                    <label asp-for="BSprfm" class="form-check-label cursor-pointer">Permiso SPRFM</label>
                </div>

                <div class="form-check form-switch mb-2">
                    <input asp-for="BSiisu" type="checkbox" class="form-check-input cursor-pointer" />
                    <label asp-for="BSiisu" class="form-check-label cursor-pointer">Permiso SIISU</label>
                </div>

                <div class="form-check form-switch mb-2">
                    <input asp-for="BActivo" type="checkbox" class="form-check-input cursor-pointer" />
                    <label asp-for="BActivo" class="form-check-label cursor-pointer">Activo</label>
                </div>

                <div class="text-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Empleado</button>
                </div>

            </div>
        </div>
    </form>
</div>