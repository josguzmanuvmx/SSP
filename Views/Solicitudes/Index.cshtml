@using SSP.ViewModels;
@using SSP.Models;
@model IEnumerable<VmSolicitud>

@{
    ViewData["Title"] = "Listado de Solicitudes";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssSolicitudes.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/Scripts/jsSolicitudes.js" asp-append-version="true"></script>
}

<div class="container-fluid col-12 col-md-10 col-lg-6 text-start">
    <br /><br />
    <div class="d-flex gap-3 align-items-center" style="min-height: 3rem;">
        <a class="btn btn-outline-secondary d-flex p-2" asp-controller="Inicio" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h4 class="text-start m-0">Solicitudes</h4>
    </div>
    <br />
    <div class="row mt-2 mb-2">
        <div class="col-5 col-md-3 order-2 order-md-1 me-auto">
            <div class="input-group">
                <label class="input-group-text" for="rowsSelector">Ver:</label>
                <select id="ddlSolicitudes" class="form-select">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
        <div class="col-12 col-md-6 order-1 order-md-2 mb-2 mb-md-0">
            <div class="col-12 col-md-11 m-auto">
                <div class="input-group">
                    <input id="txtBuscar" type="text" class="form-control" placeholder="Escriba el nombre de una solicitud" aria-label="Buscar Solicitud" />
                    @* <button id="btnBuscar" class="btn btn-outline-secondary" type="button" data-bs-toggle="tooltip" data-bs-container="button" data-bs-placement="top" data-bs-title="Buscar">Buscar</button> *@
                </div>
            </div>
        </div>
        <div class="col-5 col-md-3 order-3 order-md-3 text-end">
            <a asp-action="Index" asp-controller="Solicitud" id="btnAgregar" class="btn btn-primary btn-md me-1" data-bs-toggle="tooltip" title="Agregar">
                @* <span class="me-2">Nuevo</span> *@
                <i class="fa-solid fa-circle-plus"></i>
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table id="tblSolicitudes" name="tblSolicitudes" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th class="py-3 text-secondary text-uppercase small fw-bold text-center">Folio</th>
                    <th class="py-3 text-secondary text-uppercase small fw-bold">Solicitante</th>
                    <th class="py-3 text-secondary text-uppercase small fw-bold">Dependencia (Clave)</th>
                    <th class="py-3 text-secondary text-uppercase small fw-bold">Fecha Creación</th>
                    <th class="py-3 text-secondary text-uppercase small fw-bold text-center">Estado</th>
                    <th class="py-3 text-secondary text-uppercase small fw-bold text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var solicitud in Model)
                    {
                        <tr class="align-middle">
                            @* 1. Folio *@
                            <td class="text-center">
                                <span class="">@solicitud.SFolio</span>
                            </td>

                            @* 2. Solicitante *@
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="fw-semibold text-dark">@solicitud.SNomEmpl</span>
                                    <div class="d-flex gap-2 text-muted mt-1" style="font-size: 0.75rem;">
                                        <span><i class="fa-regular fa-id-badge"></i> @solicitud.NNoPer</span>
                                        <span><i class="fa-regular fa-user"></i> @solicitud.SUsuario</span>
                                    </div>
                                </div>
                            </td>

                            @* 3. Dependencia *@
                            <td class="text-center">
                                <span>@solicitud.NUResClv</span>
                            </td>

                            @* 4. Fecha *@
                            <td>
                                <span class="text-secondary small">
                                    @solicitud.DtFecCre.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>

                            @* 5. Estado *@
                            <td class="text-center">
                                @if (solicitud.NEstado == 1)
                                {
                                    <span class="badge badge-pendiente rounded-pill px-3 py-2">
                                        <i class="fa-regular fa-clock me-1"></i> Pendiente
                                    </span>
                                }
                                else if (solicitud.NEstado == 2)
                                {
                                    <span class="badge badge-finalizado rounded-pill px-3 py-2">
                                        <i class="fa-solid fa-check me-1"></i> Finalizado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border rounded-pill">Desconocido</span>
                                }
                            </td>

                            @* 6. Acciones *@
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    @* BOTÓN EDITAR (Navegación GET) *@
                                    @* Nota: Cambié asp-route-sId por asp-route-id si tu controller espera 'id', 
                                        pero si tu controller espera 'sId', déjalo como lo tenías *@
                                    <a asp-controller="Solicitud" 
                                        asp-action="Editar" 
                                        asp-route-sId="@solicitud.SId" 
                                        class="btn btn-sm btn-outline-secondary fs-6 px-2 py-1 border-0 rounded-2"
                                        data-bs-toggle="tooltip" 
                                        title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    @* BOTÓN ELIMINAR (Acción POST vía JS) *@
                                    @* Usamos <button> en vez de <a> porque ejecuta una acción, no navega *@
                                    <button type="button"
                                            onclick="fnAbrirModalEliminar('@solicitud.SId')"
                                            class="btn btn-sm btn-outline-danger fs-6 px-2 py-1 border-0 rounded-2"
                                            data-bs-toggle="tooltip"
                                            title="Eliminar">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>

                                    @* Botón Editar *@
                                    @* <a asp-controller="Solicitud" asp-action="Editar" asp-route-id="@item.SId"
                                        class="btn btn-sm btn-light text-primary border hover-scale"
                                        data-bs-toggle="tooltip" title="Editar / Ver Detalles">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a> *@

                                    @* Botón Eliminar *@
                                    @* <button type="button" onclick="fnEliminarSolicitud('@item.SId')"
                                            class="btn btn-sm btn-light text-danger border hover-scale"
                                            data-bs-toggle="tooltip" title="Eliminar">
                                        <i class="fa-solid fa-trash"></i>
                                    </button> *@

                                    @* <a asp-action="Editar" asp-controller="Solicitud" asp-route-sId="@solicitud.SId" class="btn btn-sm btn-outline-secondary fs-6 px-1 py-0 border-0 rounded-2">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-action="Eliminar" asp-route-sId="@solicitud.SId" class="btn btn-sm btn-outline-danger fs-6 px-1 py-0 border-0 rounded-2">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a> *@


                                    @* <a asp-action="Editar" asp-route-sId="@empleado.SId" class="btn btn-sm btn-outline-secondary fs-6 px-1 py-0 border-0 rounded-2">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-action="Eliminar" asp-route-sId="@empleado.SId" class="btn btn-sm btn-outline-danger fs-6 px-1 py-0 border-0 rounded-2">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a> *@

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="6" class="text-center py-5">
                            <div class="d-flex flex-column align-items-center opacity-50">
                                <i class="fa-regular fa-folder-open fa-3x mb-3 text-secondary"></i>
                                <h5 class="text-muted fw-bold">No hay solicitudes registradas</h5>
                                <p class="text-muted small">Haz clic en "Nueva Solicitud" para comenzar.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Modal Eliminar *@
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold" id="modalEliminarLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3 text-danger opacity-75">
                    <i class="fa-regular fa-trash-can fa-4x"></i>
                </div>
                <h5 class="fw-bold">¿Estás seguro?</h5>
                <p class="text-muted mb-0">Esta acción eliminará la solicitud permanentemente y no se puede deshacer.</p>

                <input type="hidden" id="hdnIdEliminar" value="" />
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarEliminar" class="btn btn-danger px-4">
                    <i class="fa-solid fa-trash-can me-2"></i> Sí, eliminar
                </button>
            </div>
        </div>
    </div>
</div>