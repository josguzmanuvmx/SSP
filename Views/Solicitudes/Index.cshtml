@using SSP.ViewModels;
@using SSP.Models;
@model IEnumerable<VmSolicitud>

@{
    ViewData["Title"] = "Listado de Solicitudes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssSprfm.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <style>
        .hover-scale {
            transition: transform 0.2s;
        }

            .hover-scale:hover {
                transform: scale(1.1);
            }
        /* Colores suaves para los badges */
        .badge-pendiente {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        .badge-finalizado {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            // Inicializar DataTables solo si hay datos
            if ($('#tblSolicitudes tbody tr').length > 0 && !$('#tblSolicitudes tbody .empty-row').length) {
                $('#tblSolicitudes').DataTable({
                    language: { url: "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json" },
                    columnDefs: [{ orderable: false, targets: 4 }], // No ordenar columna acciones
                    order: [[3, 'desc']] // Ordenar por fecha (columna 3)
                });
            }
        });

        // Función simulada para eliminar
        function fnEliminarSolicitud(id) {
            Swal.fire({
                title: '¿Eliminar solicitud?',
                text: "Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Aquí iría tu fetch/ajax para eliminar
                    Swal.fire('Eliminado', 'El registro ha sido eliminado.', 'success');
                }
            });
        }
    </script>
}

<div class="container-fluid col-12 col-md-10 col-lg-9 col-xl-8 text-start">
    <br /><br />

    @* --- ENCABEZADO --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex gap-3 align-items-center">
            <a class="btn btn-outline-secondary border-0 shadow-sm d-flex p-2 rounded-circle" asp-controller="Inicio" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold m-0 text-dark">Solicitudes de Acceso</h4>
                <small class="text-muted">Historial de solicitudes registradas.</small>
            </div>
        </div>

        <a asp-controller="Solicitud" asp-action="Index" class="btn btn-primary shadow-sm fw-semibold px-4 rounded-pill">
            <i class="fa-solid fa-plus me-2"></i> Nueva Solicitud
        </a>
    </div>

    @* --- TABLA --- *@
    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblSolicitudes" class="table table-hover align-middle mb-0 text-nowrap w-100">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Folio</th>
                            <th class="py-3 text-secondary text-uppercase small fw-bold">Solicitante</th>
                            <th class="py-3 text-secondary text-uppercase small fw-bold">Dependencia (UR)</th>
                            <th class="py-3 text-secondary text-uppercase small fw-bold">Fecha Creación</th>
                            <th class="py-3 text-secondary text-uppercase small fw-bold text-center">Estado</th>
                            <th class="py-3 text-secondary text-uppercase small fw-bold text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @* 1. Folio *@
                                    <td class="ps-4">
                                        <span class="fw-bold text-primary">#@item.SId</span>
                                    </td>

                                    @* 2. Solicitante *@
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold text-dark">@item.SNomEmpl</span>
                                            <div class="d-flex gap-2 text-muted" style="font-size: 0.75rem;">
                                                <span><i class="fa-regular fa-id-badge"></i> @item.NNoPer</span>
                                                <span>&bull;</span>
                                                <span><i class="fa-regular fa-user"></i> @item.SUsuario</span>
                                            </div>
                                        </div>
                                    </td>

                                    @* 3. Dependencia *@
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-building-columns text-secondary opacity-50"></i>
                                            <span class="text-dark">
                                                @* Si tuviéramos el nombre lo pondríamos aquí, por ahora usamos la clave *@
                                                Clave: @item.NUResClv
                                            </span>
                                        </div>
                                    </td>

                                    @* 4. Fecha *@
                                    <td>
                                        <span class="text-secondary small">
                                            @item.DtFecCre.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>

                                    @* 5. Estado *@
                                    <td class="text-center">
                                        @if (item.NEstado == 1)
                                        {
                                            <span class="badge badge-pendiente rounded-pill px-3 py-2">
                                                <i class="fa-regular fa-clock me-1"></i> Pendiente
                                            </span>
                                        }
                                        else if (item.NEstado == 2)
                                        {
                                            <span class="badge badge-finalizado rounded-pill px-3 py-2">
                                                <i class="fa-solid fa-check me-1"></i> Finalizado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill">Desconocido</span>
                                        }
                                    </td>

                                    @* 6. Acciones *@
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            @* Botón Editar *@
                                            <a asp-controller="Solicitud" asp-action="Editar" asp-route-id="@item.SId"
                                               class="btn btn-sm btn-light text-primary border hover-scale"
                                               data-bs-toggle="tooltip" title="Editar / Ver Detalles">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            @* Botón Eliminar *@
                                            <button type="button" onclick="fnEliminarSolicitud('@item.SId')"
                                                    class="btn btn-sm btn-light text-danger border hover-scale"
                                                    data-bs-toggle="tooltip" title="Eliminar">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="empty-row">
                                <td colspan="6" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center opacity-50">
                                        <i class="fa-regular fa-folder-open fa-3x mb-3 text-secondary"></i>
                                        <h5 class="text-muted fw-bold">No hay solicitudes registradas</h5>
                                        <p class="text-muted small">Haz clic en "Nueva Solicitud" para comenzar.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <br />
</div>