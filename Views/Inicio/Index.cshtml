@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssSeleccion.css" asp-append-version="true" />
}

<div class="container-fluid col-12 col-md-8 col-lg-7 col-xl-6 text-center">
    <br /><br />
    <div class="d-flex justify-content-center align-items-center" style="min-height: 3rem;">
        <h3 class="m-0">¡Bienvenid@@, selecciona una acción!</h3>
    </div>
    <br /><br /><br />
    <div class="d-flex flex-wrap justify-content-center align-items-center g-4 mt-5 gap-3 gap-md-4 gap-lg-5">
        <div class="item-solicitud bg-white border text-dark rounded-3 p-3 d-flex flex-column justify-content-center align-items-center shadow" style="width: 16rem; height: 14rem;">
            <i class="fa-solid fa-file-circle-plus" style="font-size: 5.6rem; padding: .4rem;"></i>
            <h4 class="card-title mt-4">Crear Solicitud</h4>
            <a asp-controller="Solicitud" asp-action="Index" class="stretched-link"></a>
        </div>

        <div class="item-solicitud bg-white border text-dark rounded-3 p-3 d-flex flex-column justify-content-center align-items-center shadow" style="width: 16rem; height: 14rem;">
            <i class="fa-solid fa-folder-open" style="font-size: 6rem;"></i>
            <h4 class="card-title mt-4">Ver Solicitudes</h4>
            <a asp-controller="Solicitudes" asp-action="Index" class="stretched-link"></a>
        </div>

        <div class="item-solicitud bg-white border text-dark rounded-3 p-3 d-flex flex-column justify-content-center align-items-center shadow" style="width: 16rem; height: 14rem;">
            <i class="fa-solid fa-folder-open" style="font-size: 6rem;"></i>
            <h4 class="card-title mt-4">Sprfm</h4>
            <a asp-controller="Sprfm" asp-action="Index" class="stretched-link"></a>
        </div>
    </div>
</div>


