@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssSeleccion.css" asp-append-version="true" />
}

<div class="container-fluid col-12 col-md-8 col-lg-7 col-xl-5 text-center">
    <br /><br />
    <div class="d-flex gap-3 align-items-center" style="min-height: 3rem;">
        <a class="btn btn-secondary d-flex p-2" asp-controller="Inicio" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h4 class="text-start m-0">Subir solicitud</h4>
    </div>
    <br /><br /><br />
    <div class="">
        <form method="post" asp-action="SubirDocumento" enctype="multipart/form-data">

            <div class="card shadow rounded-4 border-0">
                <div class="card-header bg-primary text-white rounded-top-4 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-cloud-arrow-up me-2"></i> Subir Documento</h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-4">
                        <label for="archivoInput" class="form-label fw-semibold text-secondary">Selecciona tu documento</label>

                        <input type="file" class="form-control" id="archivoInput" name="archivo"
                                accept=".pdf,.doc,.docx,.jpg,.png" required>

                        <div class="form-text">Formatos aceptados: PDF, Word, Imagenes. Máx 5MB.</div>
                    </div>

                    <div id="previewContainer" class="d-none bg-light rounded-3 p-3 mb-4 text-center border border-dashed">
                        <i class="fa-solid fa-file-lines fa-3x text-primary mb-2"></i>
                        <h6 id="nombreArchivo" class="text-dark fw-bold mb-0">nombre_archivo.docx</h6>
                        <small id="pesoArchivo" class="text-muted">0 KB</small>
                    </div>

                    <div class="mb-4">
                        <label for="comentariosInput" class="form-label fw-semibold text-secondary">Comentarios / Observaciones</label>
                        <div class="input-group">
                            <textarea class="form-control" id="comentariosInput" name="comentarios" rows="4"
                                        placeholder="Escribe aquí cualquier detalle importante sobre este documento..."></textarea>
                        </div>
                    </div>

                    <div class="">
                        <button type="submit" class="btn btn-danger">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            Enviar solicitud
                        </button>
                    </div>

                </div>
            </div>

        </form>
    </div>
</div>
