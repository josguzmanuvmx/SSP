@using System.Text.Json
@using SSP.ViewModels;
@using SSP.Models;
@model VmSolicitud
@{
    ViewData["Title"] = "Generar Solicitud";
    bool bDocActivo = Model.MoEstudiantes!.BActivo || Model.MoFinanzas!.BActivo || Model.MoHumanos!.BActivo;
    bool bModoEdicion = !string.IsNullOrEmpty(Model.SId);
    string sTitulo = bModoEdicion ? $"Editar Solicitud" : "Nueva Solicitud";

}
@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssSolicitud.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Scripts/jsSolicitud.js" asp-append-version="true"></script>
}

<div class="container container-fluid">
    <div class="d-flex align-items-center gap-3 mt-4" style="min-height: 3rem;">
        <a id="btnRegresar" class="btn btn-outline-secondary border border-dark-subtle d-flex p-2" asp-controller="Inicio" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h4 class="text-start m-0">
            @Html.Raw(sTitulo) <small class="text-muted fs-6">Folio: @Model.SFolio</small>
        </h4>
    </div>
    <form id="formSolicitud"
        method="post" asp-action="Guardar"
        data-url-preview="@Url.Action("PrevisualizarBorrador", "Solicitud")"
        data-url-zip="@Url.Action("DescargarZipBorrador", "Solicitud")"
        data-url-guardar="@Url.Action("Guardar", "Solicitud")"
        data-url-actualizar="@Url.Action("Actualizar", "Solicitud")"
        novalidate>
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="SId" />
        <input type="hidden" id="txtLsHumaAdi" name="LsHumaAdiJson" 
            value='@JsonSerializer.Serialize(Model.MoHumanos?.LsHumaAdi ?? new List<MoHumanosAdicional>())' />

        <div class="d-flex align-items-center w-100 mt-4 mb-4">
            
            <!-- Línea inicio (Completada - Azul) -->
            <div id="divLineaUsuario" class="divLineaEstilo"></div>
            <div id="divLineaUsuario2" class="divLineaEstilo"></div>
            
            <!-- Paso 1: Usuario (Completado) -->
            <div id="divIconoUsuario" class="divIconoEstilo">
                <i class="fa-solid fa-user"></i>
                <span class="spanIconoEstilo">Usuario</span>
            </div>
            
            <!-- Línea 1 a 2 (Completada - Azul) -->
            <div id="divLineaPermisos" class="divLineaEstilo"></div>
            <div id="divLineaPermisos2" class="divLineaEstilo"></div>
            <div id="divLineaPermisos3" class="divLineaEstilo"></div>
            
            <!-- Paso 2: Permisos (Activo - Azul) -->
            <div id="divIconoPermisos" class="divIconoEstilo">
                <i class="fa-solid fa-file-circle-check"></i>
                <span class="spanIconoEstilo">Permisos</span>
            </div>
            
            <!-- Línea 2 a 3 (Pendiente - Gris) -->
            <div id="divLineaDescargar" class="divLineaEstilo"></div>
            <div id="divLineaDescargar2" class="divLineaEstilo"></div>
            <div id="divLineaDescargar3" class="divLineaEstilo"></div>
            
            <!-- Paso 3: Descargar (Pendiente - Gris) -->
            <div id="divIconoDescargar" class="divIconoEstilo">
                <i class="fa-solid fa-print"></i>
                <span class="spanIconoEstilo">Descargar</span>
            </div>
            
            <!-- Línea 3 a 4 (Pendiente - Gris) -->
            <div id="divLineaFinalizar" class="divLineaEstilo"></div>
            <div id="divLineaFinalizar2" class="divLineaEstilo"></div>
            <div id="divLineaFinalizar3" class="divLineaEstilo"></div>
            
            <!-- Paso 4: Finalizar (Pendiente - Gris) -->
            <div id="divIconoFinalizar" class="divIconoEstilo">
                <i class="fa-solid fa-check"></i>
                <span class="spanIconoEstilo">Finalizar</span>
            </div>
            
            <!-- Línea final (Pendiente - Gris) -->
            <div id="divLineaFinalizar4" class="divLineaEstilo"></div>
            <div id="divLineaFinalizar5" class="divLineaEstilo"></div>

        </div>

        <div class="wizard-container position-relative mt-4 mb-5">
            <!-- Línea de progreso de fondo -->
            <div class="progress position-absolute w-100" style="height: 4px; top: 22px; z-index: 0; left: 0; background-color: #e9ecef;">
                <div id="wizardProgress" class="progress-bar bg-primary" role="progressbar" style="width: 0%; transition: width 0.4s ease;"></div>
            </div>

            <ul class="nav nav-pills nav-justified position-relative w-100" id="ulSolicitud" role="tablist" style="z-index: 1;">
                
                <li class="nav-item" role="presentation">
                    <button id="btnUsuario" data-bs-target="#divUsuario" aria-controls="divUsuario" class="nav-link wizard-step active pe-none bg-transparent" data-bs-toggle="pill" type="button" role="tab" aria-selected="true">
                        <div class="wizard-icon mx-auto shadow-sm">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="wizard-label mt-2">Usuario</div>
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button id="btnPermisos" data-bs-target="#divPermisos" aria-controls="divPermisos" class="nav-link wizard-step pe-none bg-transparent" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                        <div class="wizard-icon mx-auto shadow-sm">
                            <i class="fa-solid fa-file-circle-check"></i>
                        </div>
                        <div class="wizard-label mt-2">Permisos</div>
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button id="btnDescargar" data-bs-target="#divDescargar" aria-controls="divDescargar" class="nav-link wizard-step pe-none bg-transparent" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                        <div class="wizard-icon mx-auto shadow-sm">
                            <i class="fa-solid fa-print"></i>
                        </div>
                        <div class="wizard-label mt-2">Descargar</div>
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button id="btnFinalizar" data-bs-target="#divFinalizar" aria-controls="divFinalizar" class="nav-link wizard-step pe-none bg-transparent" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                        <div class="wizard-icon mx-auto shadow-sm">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div class="wizard-label mt-2">Finalizar</div>
                    </button>
                </li>
                
            </ul>
        </div>

        <div class="tab-content mt-2 mb-4" id="divSolicitud">

            <!-- Usuario -->
            <div id="divUsuario" aria-labelledby="btnUsuario" class="tab-pane fade show active" role="tabpanel" tabindex="0">
                <div class="card bg-white border shadow rounded">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold">Datos del Usuario</h5>
                        <h6 class="text-muted fw-semibold">Ingrese los datos del usuario a asignar, modificar o eliminar sus permisos.</h6>
                        <div id="divBusquedaUsuario" class="d-flex flex-column mt-3 px-2 py-2 bg-light rounded border">
                            <div class="d-flex align-items-center mb-2">
                                <label class="form-label text-sm m-0">Busca un empleado rapidamente.</label>
                                <button id="btnManual" class="btn btn-link border-0 ms-auto p-0">Ingresar los datos manualmente.</button>
                            </div>
                            <div class="position-relative">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                                    <input type="text" id="txtUsuario" class="form-control border-start-0 ps-1" placeholder="Buscar por Nombre, Usuario o No. Personal..." autocomplete="off" data-url="@Url.Action("BuscarUsuarios", "Solicitud")" />
                                </div>
                                <div id="divResultados" class="list-group position-absolute w-100 shadow"
                                    style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                                </div>
                            </div>
                        </div>
                        <div id="divUsuario" class="d-flex flex-column gap-1 mt-3">
                            <div class="row align-items-center">
                                <label asp-for="SNomEmpl" class="col-md-4 col-form-label">Nombre del empleado</label>
                                <div class="col-md-8">
                                    <input asp-for="SNomEmpl" class="form-control bg-light pe-none" placeholder="ej. Samuel Miral Ramirez" tabindex="-1" required readonly />
                                    <span asp-validation-for="SNomEmpl" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="NNoPer" class="col-md-4 col-form-label">Número de personal</label>
                                <div class="col-md-8">
                                    <input asp-for="NNoPer" class="form-control bg-light pe-none" placeholder="ej. 61399" tabindex="-1" readonly required />
                                    <span asp-validation-for="NNoPer" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="SUsuario" class="col-md-4 col-form-label">Usuario</label>
                                <div class="col-md-8">
                                    <input asp-for="SUsuario" class="form-control bg-light pe-none" placeholder="ej. josguzman" tabindex="-1" readonly required />
                                    <span asp-validation-for="SUsuario" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="SCorreo" class="col-md-4 col-form-label">Correo institucional</label>
                                <div class="col-md-8">
                                    <input asp-for="SCorreo" class="form-control bg-light pe-none" placeholder="ej. usuario@uv.mx" tabindex="-1" readonly required />
                                    <span asp-validation-for="SCorreo" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="Region" class="col-md-4 col-form-label">Región</label>
                                <div class="col-md-8">
                                    <select asp-for="Region" class="form-select bg-light" asp-items="Html.GetEnumSelectList<Region>()" tabindex="-1" disabled></select>
                                    <span asp-validation-for="Region" class="text-danger"></span>
                                    <input type="hidden" asp-for="Region" required />
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="SPueEmpl" class="col-md-4 col-form-label">Puesto</label>
                                <div class="col-md-8">
                                    <input asp-for="SPueEmpl" class="form-control bg-light pe-none" placeholder="ej. Becario" tabindex="-1" readonly required />
                                    <span asp-validation-for="SPueEmpl" class="text-danger"></span>
                                </div>
                            </div>

                            <hr class="my-3">

                            <h6 class="fw-semibold mb-2">Datos adicionales</h6>


                            <div class="row align-items-center mb-2">
                                <label asp-for="Dependencia" class="col-md-4 col-form-label">Unidad Responsable</label>

                                <div class="col-md-8 position-relative">

                                    <input type="hidden" asp-for="Dependencia" id="txtDependenciaEnum" required />

                                    @{
                                        bool bDependenciaSeleccionada = Convert.ToInt32(Model.Dependencia) > 0;
                                        string sClaseBusqueda = bDependenciaSeleccionada ? "d-none" : "";
                                        string sClaseSeleccion = bDependenciaSeleccionada ? "d-flex" : "d-none";
                                        string divHtmlSeleccionado = "";

                                        if (bDependenciaSeleccionada)
                                        {
                                            string sDependenciaActual = ((int)Model.Dependencia).ToString();

                                            var moDependencia = Model.LsDependencias.FirstOrDefault(x => x.SCodigo == sDependenciaActual);

                                            if (moDependencia != null)
                                            {
                                                // Generamos el HTML: Azul para Código, Negro para Dependencia
                                                divHtmlSeleccionado = $"<span class='codigo fw-semibold'>{moDependencia.SCodigo}</span> <span class='dep mx-1'>-</span> <span>{moDependencia.SDependencia}</span>";
                                            }
                                        }
                                    }

                                    <div id="divContenedorBuscar" class="@sClaseBusqueda">
                                        <div class="input-group">
                                            <span class="input-group-text bg-transparent text-muted border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                                            <input type="text" id="txtBuscarDep" class="form-control border-start-0 ps-1"
                                                placeholder="Buscar clave o nombre..." autocomplete="off" />
                                        </div>
                                        <div id="divResultadosDep" class="list-group position-absolute w-100 mb-1 shadow-sm bottom-100"
                                            style="z-index: 1050; max-height: 250px; overflow-y: auto; display: none;"></div>
                                    </div>

                                    <div id="divContenidoSeleccionado" class="@sClaseSeleccion align-items-center justify-content-between bg-white border rounded px-3 py-2 shadow-sm" style="min-height: 38px;">
                                        <div class="d-flex align-items-center w-100 overflow-hidden">
                                            <i class="fa-solid fa-building-columns text-primary me-2 flex-shrink-0"></i>
                                            <span id="spTextoSeleccionado" class="text-wrap text-break" style="line-height: 1.2;">
                                                @Html.Raw(divHtmlSeleccionado)
                                            </span>
                                        </div>
                                        <button type="button" id="btnEliminarSeleccion" class="btn btn-sm btn-link text-danger p-0 ms-3 flex-shrink-0">
                                            <i class="fa-solid fa-circle-xmark fa-lg"></i>
                                        </button>
                                    </div>

                                    <span asp-validation-for="Dependencia" class="text-danger small mt-1"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Permisos -->
            <div id="divPermisos" aria-labelledby="btnPermisos" class="tab-pane fade" role="tabpanel" tabindex="0">
                <div class="card bg-white border shadow rounded">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold">Area de Permisos</h5>
                        <h6 class="text-muted mb-1">Habilite las areas a modificar sus permisos, Estudiantes, Finanzas ó Recursos Humanos.</h6>
                        <h6 class="text-muted">Puede generar múltiples permisos para un mismo usuario.</h6>

                        <ul class="nav nav-pills nav-fill gap-1 mt-3" id="ulPermisos" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button id="btnEstudiantes" data-bs-target="#divEstudiantes" aria-controls="divEstudiantes" class="custom-tab nav-link shadow-sm" data-bs-toggle="pill" type="button" role="tab" aria-selected="true" disabled>
                                    <i class="fa-solid fa-user-graduate me-2"></i> Estudiantes
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button id="btnFinanzas" data-bs-target="#divFinanzas" aria-controls="divFinanzas" class="custom-tab nav-link shadow-sm active" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                                    <i class="fa-solid fa-hand-holding-dollar me-2"></i> Finanzas
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button id="btnHumanos" data-bs-target="#divHumanos" aria-controls="divHumanos" class="custom-tab nav-link shadow-sm" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                                    <i class="fa-solid fa-users me-2"></i> R. Humanos
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="divPermisosContent">

                            <!-- Estudiantes -->
                            <div id="divEstudiantes" aria-labelledby="btnEstudiantes" class="tab-pane fade" role="tabpanel" tabindex="0">

                                <input type="checkbox" asp-for="MoEstudiantes.BActivo" id="txtEstuAct" class="d-none">

                                <div class="position-relative rounded-3 overflow-hidden p-2">
                                    
                                    <div id="divOverlayEstudiantes" class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center bg-white bg-opacity-50" style="z-index: 10; backdrop-filter: blur(2px);">
                                        <button type="button" id="btnHabilitarEstudiantes" class="btn btn-primary shadow rounded-pill px-4 py-3 fw-bold fs-6 mb-3">
                                            <i class="fa-solid fa-user-check me-2"></i> Habilitar Estudiantes
                                        </button>
                                    </div>

                                    <div id="divContenidoEstudiantes" style="opacity: 0.3; pointer-events: none;">

                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <h6 class="fw-semibold m-0">Estudiantes</h6>
                                            <button type="button" id="btnDeshabilitarEstudiantes" class="btn btn-sm btn-outline-danger border-0 d-none" title="Deshabilitar Estudiantes">
                                                <i class="fa-solid fa-ban"></i> Deshabilitar Estudiantes
                                            </button>
                                        </div>

                                        <br />
                                        <h6 class="text-muted">En mantenimiento...</h6>
                                        <br />

                                    </div>
                                </div>
                            </div>

                            <!-- Finanzas -->
                            <div id="divFinanzas" aria-labelledby="btnFinanzas" class="tab-pane fade show active" role="tabpanel" tabindex="0">

                                <input type="checkbox" asp-for="MoFinanzas.BActivo" id="txtFinaAct" class="d-none">

                                <div class="position-relative rounded-3 overflow-hidden p-2">

                                    <div id="divOverlayFinanzas" class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center bg-white bg-opacity-50" style="z-index: 10; backdrop-filter: blur(2px);">
                                        <button type="button" id="btnHabilitarFinanzas" class="btn btn-primary shadow rounded-pill px-4 py-3 fw-bold fs-6 mb-3">
                                            <i class="fa-solid fa-user-check me-2"></i> Habilitar Finanzas
                                        </button>
                                    </div>

                                    <div id="divContenidoFinanzas" style="opacity: 0.3; pointer-events: none;">

                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <h6 class="fw-semibold m-0">Tipo de Permiso</h6>
                                            <button type="button" id="btnDeshabilitarFinanzas" class="btn btn-sm btn-outline-danger border-0 d-none" title="Deshabilitar Finanzas">
                                                <i class="fa-solid fa-ban"></i> Deshabilitar Finanzas
                                            </button>
                                        </div>

                                        <div class="d-flex gap-2 gap-md-5 mt-3 justify-content-around justify-content-md-center">
                                            <div class="form-check">
                                                <input asp-for="MoFinanzas.Movimiento" id="SAlta" class="form-check-input" type="radio" value="SAlta">
                                                <label for="SAlta" class="form-check-label">Alta</label>
                                            </div>
                                            <div class="form-check">
                                                <input asp-for="MoFinanzas.Movimiento" id="SModifi" class="form-check-input" type="radio" value="SModifi">
                                                <label for="SModifi" class="form-check-label">Modificación</label>
                                            </div>
                                            <div class="form-check">
                                                <input asp-for="MoFinanzas.Movimiento" id="SBaja" class="form-check-input" type="radio" value="SBaja">
                                                <label for="SBaja" class="form-check-label">Baja</label>
                                            </div>
                                        </div>

                                        <hr class="my-3">

                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="fw-semibold mb-1">Grupo o Permiso Solicitado</h6>
                                                <div class="text-muted" style="font-size: 0.9rem;">
                                                    Puede seleccionar más de uno:
                                                </div>
                                            </div>
                                            <a id="btnGlosarioActividades" class="btn btn-secondary btn-sm py-1 px-2" tabindex="-1" href="#" data-bs-toggle="modal" data-bs-target="#mdlGlosarioActividades"><i class="fa-solid fa-circle-info"></i> Todos los permisos</a>
                                        </div>

                                        <div class="row g-1 mt-2">
                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BDirec" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BDirec" class="form-check-label d-flex align-items-center gap-2">
                                                    @Html.DisplayNameFor(m => m.BDirec)
                                                    <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                                    title="@Html.DescriptionFor(m => m.BDirec)"></i>
                                                </label>
                                            </div>

                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BDirGen" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BDirGen" class="form-check-label d-flex align-items-center gap-2">
                                                    @Html.DisplayNameFor(m => m.BDirGen)
                                                    <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                                    title="@Html.DescriptionFor(m => m.BDirGen)"></i>
                                                </label>
                                            </div>

                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BAdmin" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BAdmin" class="form-check-label d-flex align-items-center gap-2">
                                                    @Html.DisplayNameFor(m => m.BAdmin)
                                                    <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                                    title="@Html.DescriptionFor(m => m.BAdmin)"></i>
                                                </label>
                                            </div>

                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BAuxAdm" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BAuxAdm" class="form-check-label d-flex align-items-center gap-2">
                                                    @Html.DisplayNameFor(m => m.BAuxAdm)
                                                    <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                                    title="@Html.DescriptionFor(m => m.BAuxAdm)"></i>
                                                </label>
                                            </div>

                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BResProy" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BResProy" class="form-check-label d-flex align-items-center gap-2">
                                                    @Html.DisplayNameFor(m => m.BResProy)
                                                    <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                                    title="@Html.DescriptionFor(m => m.BResProy)"></i>
                                                </label>
                                            </div>

                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BResCB" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BResCB" class="form-check-label d-flex align-items-center gap-2">
                                                    @Html.DisplayNameFor(m => m.BResCB)
                                                    <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                                    title="@Html.DescriptionFor(m => m.BResCB)"></i>
                                                </label>
                                            </div>

                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BEstudi" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BEstudi" class="form-check-label d-flex align-items-center gap-2">
                                                    @Html.DisplayNameFor(m => m.BEstudi)
                                                    <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                                    title="@Html.DescriptionFor(m => m.BEstudi)"></i>
                                                </label>
                                            </div>

                                            <div class="form-check col-12 col-md-6">
                                                <input asp-for="MoFinanzas.BEvenIng" class="form-check-input" type="checkbox">
                                                <label asp-for="MoFinanzas.BEvenIng" class="form-check-label d-flex align-items-center gap-2">
