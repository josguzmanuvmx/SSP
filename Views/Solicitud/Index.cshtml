            <h6 class="fw-semibold">Datos del Usuario Adicional #<span class="sp-numero"></span></h6>
        </div>
        <div class="bg-light p-2 rounded border mb-3 div-search-wrapper">
            <div class="d-flex align-items-center mb-2">
                <label class="form-label text-sm m-0">Busca un empleado rapidamente.</label>
                <button class="btn btn-link border-0 ms-auto p-0 btnHumaManual">Ingresar los datos manualmente.</button>
