                <div class="col-md-8">
                    <input name="LsHumaAdi[INDEX_LISTA].SNomEmpl" class="txtNomEmpl form-control bg-light pe-none" placeholder="ej. Samuel Miral" tabindex="-1" required readonly />
                    <span data-valmsg-for="LsHumaAdi[INDEX_LISTA].SNomEmpl" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex">
