                                                    string claseBusquedaHuma = bDependenciaSeleccionadaHuma ? "d-none" : "";
                                                    string claseSeleccionHuma = bDependenciaSeleccionadaHuma ? "d-flex" : "d-none";
                                                    string htmlSeleccionadoHuma = "";

                                                    if (bDependenciaSeleccionadaHuma)
                                                    {
                                                        string codigoActualHuma = ((int)Model.MoHumanos.Dependencia).ToString();

                                                        var itemHuma = Model.LsDependencias.FirstOrDefault(x => x.SCodigo == codigoActualHuma);

                                                        if (itemHuma != null)
                                                        {
                                                            // Generamos el HTML: Azul para Código, Negro para Dependencia
                                                            htmlSeleccionadoHuma = $"<span class='codigo fw-semibold'>{itemHuma.SCodigo}</span> <span class='dep mx-1'>-</span> <span>{itemHuma.SDependencia}</span>";
