@using SSP.ViewModels;
@model VmSolicitudAct
@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssSolicitud.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Scripts/jsSolicitud.js" asp-append-version="true"></script>
}

<div class="container-fluid text-start">
    <br />
    <div class="d-flex gap-3 align-items-center col-12 col-md-8 col-lg-7 col-xl-5 m-auto" style="min-height: 3rem;">
        <a id="btnRegresar" class="btn btn-secondary d-flex p-2" asp-controller="Inicio" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h4 class="text-start m-0">Solicitud</h4>
    </div>
    <form id="form-solicitud" class="d-flex flex-column gap-2 needs-validation col-12 col-md-8 col-lg-7 col-xl-5 m-auto" method="post" asp-action="DescargarSolicitud" novalidate>
        @Html.AntiForgeryToken()

        <ul class="nav nav-pills nav-fill mt-3" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation" style="margin-right: -0.6rem;">
                <button id="pills-usuario-tab" data-bs-target="#pills-usuario" aria-controls="pills-usuario" class="custom-tab nav-link shadow-sm step step-first active" data-bs-toggle="pill" type="button" role="tab" aria-selected="true">
                    <i class="fa-solid fa-user"></i> Usuario
                </button>
            </li>
            <li class="nav-item" role="presentation" style="margin-right: -0.6rem;">
                <button id="pills-permisos-tab" data-bs-target="#pills-permisos" aria-controls="pills-permisos" class="custom-tab nav-link shadow-sm step" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                    <i class="fa-solid fa-file-circle-check"></i> Permisos
                </button>
            </li>
            <li class="nav-item" role="presentation" style="margin-right: -0.6rem;">
                <button id="pills-descargar-tab" data-bs-target="#pills-descargar" aria-controls="pills-descargar" class="custom-tab nav-link shadow-sm step" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                    <i class="fa-solid fa-print"></i> Descargar
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button id="pills-finalizar-tab" data-bs-target="#pills-finalizar" aria-controls="pills-descarga" class="custom-tab nav-link shadow-sm step" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">
                    <i class="fa-solid fa-check"></i> Finalizar
                </button>
            </li>
        </ul>

        <div class="tab-content mt-2" id="pills-tabContent">

            <!-- Usuario -->
            <div id="pills-usuario" aria-labelledby="pills-usuario-tab" class="tab-pane fade show active" role="tabpanel" tabindex="0">
                <div class="card bg-white border shadow rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold">Datos del Usuario</h5>
                        <h6 class="text-muted">Aqui se ingresan los datos en general del usuario a modificar.</h6>
                        <div id="divBuscarUsuario" class="d-flex flex-column mt-3 px-3 py-2 bg-light rounded border">
                            <div class="d-flex align-items-center mb-2">
                                <label class="form-label fs-6 m-0">Busca un empleado rapidamente.</label>
                                <button id="btnManual" class="btn btn-link border-0 ms-auto p-0">Ingresar los datos manualmente.</button>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                                <input type="text" id="txtBuscarUsuario" class="form-control border-start-0" placeholder="Escribe el no. personal, usuario o nombre...">
                            </div>
                            <div id="divResultadosBusqueda" class="dropdown-menu w-100 shadow border-0 mt-1" style="max-height: 200px; overflow-y: auto;"></div>
                        </div>
                        <div id="divUsuario" class="d-flex flex-column gap-1 mt-3">
                            <div class="row align-items-center">
                                <label asp-for="vmSolicitud.SNomEmpl" class="col-md-4 col-form-label">Nombre del empleado</label>
                                <div class="col-md-8">
                                    <input asp-for="vmSolicitud.SNomEmpl" class="form-control bg-light" readonly />
                                    <span asp-validation-for="vmSolicitud.SNomEmpl" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="vmSolicitud.NNoPer" class="col-md-4 col-form-label">Número de personal</label>
                                <div class="col-md-8">
                                    <input asp-for="vmSolicitud.NNoPer" class="form-control bg-light" readonly />
                                    <span asp-validation-for="vmSolicitud.NNoPer" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="vmSolicitud.NUsrClv" class="col-md-4 col-form-label">Clave del usuario</label>
                                <div class="col-md-8">
                                    <input asp-for="vmSolicitud.NUsrClv" class="form-control bg-light" readonly />
                                    <span asp-validation-for="vmSolicitud.NUsrClv" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="vmSolicitud.SCorreo" class="col-md-4 col-form-label">Correo institucional</label>
                                <div class="col-md-8">
                                    <input asp-for="vmSolicitud.SCorreo" class="form-control bg-light" readonly />
                                    <span asp-validation-for="vmSolicitud.SCorreo" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="vmSolicitud.NUResClv" class="col-md-4 col-form-label">Unidad Responsable</label>
                                <div class="col-md-8">
                                    <div class="input-group">
                                        <input asp-for="vmSolicitud.NUResClv" class="form-control bg-light" style="max-width: 100px;" placeholder="Clave" readonly />
                                        <input asp-for="vmSolicitud.SUResNom" class="form-control bg-light" placeholder="Nombre de la UR" readonly />
                                    </div>
                                    <span asp-validation-for="vmSolicitud.NUResClv" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="vmSolicitud.SRegion" class="col-md-4 col-form-label">Región</label>
                                <div class="col-md-8">
                                    <select asp-for="vmSolicitud.SRegion" class="form-select bg-light" asp-items="Html.GetEnumSelectList<SprfmRegion>()" disabled></select>
                                    <span asp-validation-for="vmSolicitud.SRegion" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <label asp-for="vmSolicitud.SPueEmpl" class="col-md-4 col-form-label">Puesto</label>
                                <div class="col-md-8">
                                    <input asp-for="vmSolicitud.SPueEmpl" class="form-control bg-light" readonly />
                                    <span asp-validation-for="vmSolicitud.SPueEmpl" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Permisos -->
            <div id="pills-permisos" aria-labelledby="pills-permisos-tab" class="tab-pane fade" role="tabpanel" tabindex="0">
                <div class="card bg-white border shadow rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold">Area de Permisos</h5>
                        <h6 class="text-muted">Aqui habilita solo las areas a modificar sus permisos.</h6>

                        <ul class="nav nav-pills nav-fill gap-1 mt-3" id="pills-tab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button id="pills-estudiantes-tab" data-bs-target="#pills-estudiantes" aria-controls="pills-estudiantes" class="custom-tab nav-link shadow-sm active" data-bs-toggle="pill" type="button" role="tab" aria-selected="true">Estudiantes</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button id="pills-finanzas-tab" data-bs-target="#pills-finanzas" aria-controls="pills-finanzas" class="custom-tab nav-link shadow-sm" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">Finanzas</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button id="pills-humanos-tab" data-bs-target="#pills-humanos" aria-controls="pills-humanos" class="custom-tab nav-link shadow-sm" data-bs-toggle="pill" type="button" role="tab" aria-selected="false">Humanos</button>
                            </li>
                        </ul>

                        <div class="tab-content" id="pills-tabContent">

                            <!-- Estudiantes -->
                            <div id="pills-estudiantes" aria-labelledby="pills-estudiantes-tab" class="tab-pane fade show active" role="tabpanel" tabindex="0">
                                <h6 class="fw-semibold mt-3">Estudiantes</h6>
                                <h6 class="text-muted">En espera de informacion...</h6>
                            </div>

                            <!-- Finanzas -->
                            <div id="pills-finanzas" aria-labelledby="pills-finanzas-tab" class="tab-pane fade" role="tabpanel" tabindex="0">
                                <h6 class="fw-semibold mt-3">Tipo de Permiso</h6>
                                <div class="d-flex flex-fill gap-3 mt-3 justify-content-around">
                                    <div class="form-check">
                                        <input asp-for="vmSolicitud.SFinaMov" id="alta" class="form-check-input" type="radio" value="alta" checked>
                                        <label for="alta" class="form-check-label">Alta</label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="vmSolicitud.SFinaMov" id="modificacion" class="form-check-input" type="radio" value="modificacion">
                                        <label for="modificacion" class="form-check-label">Modificación</label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="vmSolicitud.SFinaMov" id="baja" class="form-check-input" type="radio" value="baja">
                                        <label for="baja" class="form-check-label">Baja</label>
                                    </div>
                                </div>

                                <hr class="my-3">

                                <h6 class="fw-semibold mb-1">Grupo o Permiso Solicitado</h6>
                                <div class="text-muted" style="font-size: 0.9rem;">
                                    Puede seleccionar más de uno:
                                </div>

                                <div class="row g-2 mt-2">
                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BDirec" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BDirec" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BDirec)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BDirec)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BDirGen" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BDirGen" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BDirGen)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BDirGen)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BAdmin" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BAdmin" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BAdmin)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BAdmin)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BAuxAdm" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BAuxAdm" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BAuxAdm)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BAuxAdm)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BResProy" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BResProy" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BResProy)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BResProy)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BResCB" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BResCB" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BResCB)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BResCB)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BEstudi" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BEstudi" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BEstudi)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BEstudi)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BEvenIng" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BEvenIng" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BEvenIng)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BEvenIng)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BSuper" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BSuper" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BSuper)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BSuper)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BCajeros" class="form-check-input" type="checkbox">
                                        <label asp-for="vmSolicitud.BCajeros" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BCajeros)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BCajeros)"></i>
                                        </label>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BRevisor" class="form-check-input toggle-detalle" type="checkbox" data-target="#detalle-revisor">
                                        <label asp-for="vmSolicitud.BRevisor" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BRevisor)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BRevisor)"></i>
                                        </label>
                                        <div id="detalle-revisor" class="mt-2 d-none">
                                            <textarea asp-for="vmSolicitud.SDetaRev" class="form-control form-control-sm" rows="2" placeholder="Especifique el revisor..."></textarea>
                                        </div>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BOtroGru" class="form-check-input toggle-detalle" type="checkbox" data-target="#detalle-otro-grupo">
                                        <label asp-for="vmSolicitud.BOtroGru" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BOtroGru)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BOtroGru)"></i>
                                        </label>
                                        <div id="detalle-otro-grupo" class="mt-2 d-none">
                                            <textarea asp-for="vmSolicitud.SDetaGru" class="form-control form-control-sm" rows="2" placeholder="Especifique el grupo..."></textarea>
                                        </div>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BUrAdici" class="form-check-input toggle-detalle" type="checkbox" data-target="#detalle-ur-adicional">
                                        <label asp-for="vmSolicitud.BUrAdici" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BUrAdici)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BUrAdici)"></i>
                                        </label>
                                        <div id="detalle-ur-adicional" class="mt-2 d-none">
                                            <textarea asp-for="vmSolicitud.SDetUrA" class="form-control form-control-sm" rows="2" placeholder="Especifique la UR..."></textarea>
                                        </div>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BPermEsp" class="form-check-input toggle-detalle" type="checkbox" data-target="#detalle-permiso-especifico">
                                        <label asp-for="vmSolicitud.BPermEsp" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BPermEsp)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BPermEsp)"></i>
                                        </label>
                                        <div id="detalle-permiso-especifico" class="mt-2 d-none">
                                            <textarea asp-for="vmSolicitud.SDetaEsp" class="form-control form-control-sm" rows="2" placeholder="Describa el permiso..."></textarea>
                                        </div>
                                    </div>

                                    <div class="form-check col-12 col-md-6">
                                        <input asp-for="vmSolicitud.BPermSim" class="form-check-input toggle-detalle" type="checkbox" data-target="#detalle-permiso-similar">
                                        <label asp-for="vmSolicitud.BPermSim" class="form-check-label d-flex align-items-center gap-2">
                                            @Html.DisplayNameFor(m => m.vmSolicitud.BPermSim)
                                            <i class="fa-solid fa-circle-info text-secondary" data-bs-toggle="tooltip" data-bs-html="true"
                                               title="@Html.DescriptionFor(m => m.vmSolicitud.BPermSim)"></i>
                                        </label>
                                        <div id="detalle-permiso-similar" class="mt-2 d-none">
                                            <textarea asp-for="vmSolicitud.SDetaSim" class="form-control form-control-sm" rows="2" placeholder="Usuario o No. Personal de referencia..."></textarea>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- Humanos -->
                            <div id="pills-humanos" aria-labelledby="pills-humanos-tab" class="tab-pane fade" role="tabpanel" tabindex="0">
                                <!-- Seleccion Permisos -->
                                <h6 class="fw-semibold mt-3">Datos adicionales</h6>
                                <div class="row align-items-center">
                                    <label asp-for="vmSolicitud.NEntClv" class="col-md-4 col-form-label">Persona que autoriza</label>
                                    <div class="col-md-8">
                                        <div class="input-group">
                                            <input asp-for="vmSolicitud.NEntClv" class="form-control bg-light" style="max-width: 100px;" placeholder="Clave" readonly />
                                            <input asp-for="vmSolicitud.SEntNomb" class="form-control bg-light" placeholder="Nombre de la persona que autoriza" readonly />
                                        </div>
                                        <span asp-validation-for="vmSolicitud.NEntClv" class="text-danger"></span>
                                    </div>
                                </div>

                                <hr class="my-4">

                                <h6 class="fw-semibold">Tipo de Movimiento</h6>
                                <div class="d-flex flex-fill gap-3 mt-3 justify-content-around">
                                    <div class="form-check">
                                        <input asp-for="vmSolicitud.SHumaMov" id="alta" class="form-check-input" type="radio" value="A" checked>
                                        <label for="alta" class="form-check-label">Alta</label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="vmSolicitud.SHumaMov" id="modificacion" class="form-check-input" type="radio" value="M">
                                        <label for="modificacion" class="form-check-label">Modificación</label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="vmSolicitud.SHumaMov" id="baja" class="form-check-input" type="radio" value="B">
                                        <label for="baja" class="form-check-label">Baja</label>
                                    </div>
                                </div>

                                <hr class="my-4">

                                <div id="info-basica" class="d-flex flex-column gap-1">
                                    <div class="d-flex">
                                        <label asp-for="vmSolicitud.NClvDep" class="col-4 col-form-label">Clave Dependencia</label>
                                        <div class="col-8">
                                            <input asp-for="vmSolicitud.NClvDep" type="number" class="form-control bg-transparent" placeholder="Dependencia" required>
                                            <span asp-validation-for="vmSolicitud.NClvDep" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="d-flex">
                                        <label asp-for="vmSolicitud.SClvProg" class="col-4 col-form-label">Clave de Programa</label>
                                        <div class="col-8">
                                            <input asp-for="vmSolicitud.SClvProg" type="number" class="form-control bg-transparent" placeholder="Programa" required>
                                            <span asp-validation-for="vmSolicitud.SClvProg" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="d-flex">
                                        <label asp-for="vmSolicitud.STipPerm" class="col-4 col-form-label">Tipo de permiso</label>
                                        <div class="col-8">
                                            <select asp-for="vmSolicitud.STipPerm"
                                                    class="form-control bg-transparent"
                                                    asp-items="Html.GetEnumSelectList<SiisuPermiso>()"
                                                    required>
                                            </select>
                                            <span asp-validation-for="vmSolicitud.STipPerm" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Descarga -->
            <div id="pills-descargar" aria-labelledby="pills-descargar-tab" class="tab-pane fade" role="tabpanel" tabindex="0">
                <div class="card bg-white border shadow rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold">Revision y Descarga</h5>
                        <h6 class="text-muted">Aqui podras previsualizar las solicitudes y descargarlas en conjunto o individualmente.</h6>
                        <div class="d-flex gap-2 justify-content-end">
                            <button id="btn-descargar-solicitud" type="submit" class="btn btn-primary w-auto" disabled>
                                <i class="fa-solid fa-file-word"></i> Descargar Word
                            </button>
                            <button id="btn-descargar-solicitud" type="submit" class="btn btn-warning w-auto" disabled>
                                <i class="fa-solid fa-eye"></i> Previsualizar
                            </button>
                            <button id="btn-descargar-solicitud" type="submit" class="btn btn-danger w-auto" disabled>
                                <i class="fa-solid fa-print"></i> Imprimir
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Finalizar -->
            <div id="pills-finalizar" aria-labelledby="pills-finalizar-tab" class="tab-pane fade" role="tabpanel" tabindex="0">
                <div class="card bg-white border shadow rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold">Finalizar</h5>
                        <h6 class="text-muted">Aqui se podra guardar la solicitud con estado "Completado" ó "Borrador" con un nombre personalizado o descartarla completamente.</h6>
                    </div>
                </div>
            </div>

        </div>

        <!-- Especificaciones -->
        @* <h6 class="fw-semibold">Especificaciones</h6>
        <textarea asp-for="vmSolicitud.SEspeci" id="especificaciones" class="form-control bg-transparent mt-3" rows="5" placeholder="Escribe tu especificación..." maxlength="500"></textarea>
        <div id="contador" class="text-end" style="font-size: .9rem;">
            500/500
        </div> *@

    </form>

    <br />
    <br />

    <!-- Glosario de actividades -->
    <div class="col-12 col-md-8 col-lg-7 col-xl-6 m-auto">
        <h4 class="fw-bold">Glosario de actividades</h4>
        <span class="mt-1">Busca y visualiza todas las actividades que puede realizar cada permiso.</span>
    </div>
    <div class="col-12 col-md-8 col-lg-7 col-xl-6 m-auto mt-3">

        <!-- Filtros -->
        <div class="row">
            <div class="col-5 col-md-3 order-2 order-md-1 me-auto">
                <div class="input-group">
                    <label class="input-group-text" for="rowsSelector">Ver:</label>
                    <select id="ddlActividades" class="form-select">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-5 order-1 order-md-2 mb-2 mb-md-0">
                <div class="col-12 col-md-11 m-auto">
                    <div class="input-group">
                        <input id="txtBuscar" type="text" class="form-control" placeholder="Escriba el permiso o descripción de la actividad" aria-label="Buscar Actividad" />
                        @* <button id="btnBuscar" class="btn btn-outline-secondary" type="button" data-bs-toggle="tooltip" data-bs-container="button" data-bs-placement="top" data-bs-title="Buscar">Buscar</button> *@
                    </div>
                </div>
            </div>
            <div class="col-5 col-md-4 order-3 order-md-3 text-end">
                <div class="input-group">
                    <label class="input-group-text" for="ddlPermisos">Filtrar:</label>
                    <select id="ddlPermisos" class="form-select cursor-pointer">
                        <option value="">Ver Todos</option>
                        @foreach (var nombrePermiso in Model.lsActividades.Select(x => x.SNombre).Distinct())
                        {
                            <option value="@nombrePermiso">@nombrePermiso</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="table-responsive mt-0 mt-md-2 pb-5">
            <table id="tblActividades" name="tblActividades" class="table table-striped table-bordered w-100">
                <thead>
                    <tr>
                        <th class="fw-semibold" style="width: 18rem;">Permiso</th>
                        <th class="fw-semibold">Actividad a realizar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var actividad in Model.lsActividades)
                    {
                        <tr>
                            <td class="align-middle col-permiso" style="font-size: 0.9rem;">
                                @actividad.SNombre
                            </td>
                            <td class="align-middle" style="font-size: 0.9rem;">
                                @Html.Raw(actividad.SDescripcion)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>


<!-- Modal confirmar salir, borrador, descartar y guardar cambios -->
<div class="modal fade" id="modalConfirmarSalida" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-secondary">
                    <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> Cambios pendientes
                </h5>
            </div>
            <div class="modal-body py-3">
                <p class="mb-0 fs-5 text-center">
                    Tienes cambios sin guardar.<br>
                    ¿Qué deseas hacer antes de salir?
                </p>
            </div>
            <div class="modal-footer border-top-0 flex-column gap-2 pb-4">

                <button type="button" id="btn-guardar-borrador" class="btn btn-primary w-100 rounded-pill py-2">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Guardar como borrador
                </button>

                <button type="button" id="btn-descartar" class="btn btn-outline-danger w-100 rounded-pill py-2">
                    <i class="fa-solid fa-trash me-2"></i> Descartar cambios
                </button>

                <button type="button" class="btn btn-link text-decoration-none text-secondary w-100" data-bs-dismiss="modal">
                    Cancelar y seguir editando
                </button>
            </div>
        </div>
    </div>
</div>