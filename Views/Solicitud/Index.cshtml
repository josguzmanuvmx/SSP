                    <input name="LsHumaAdi[INDEX_LISTA].SUsuario" class="txtHumaUsuario form-control bg-light pe-none" placeholder="ej. josguzman" tabindex="-1" required readonly />
                    <span data-valmsg-for="LsHumaAdi[INDEX_LISTA].SUsuario" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr class="my-4">

        <h6 class="fw-semibold">Tipo de Movimiento</h6>
        <div class="d-flex flex-fill gap-2 gap-md-5 mt-3 justify-content-around justify-content-md-center">
            <div class="form-check">
                <input name="LsHumaAdi[INDEX_LISTA].Movimiento" id="MovA_RADIO_ID" class="form-check-input" type="radio" value="SAlta" checked>
                <label for="MovA_RADIO_ID" class="form-check-label">Alta</label>
            </div>
            <div class="form-check">
                <input name="LsHumaAdi[INDEX_LISTA].Movimiento" id="MovM_RADIO_ID" class="form-check-input" type="radio" value="SModifi">
                <label for="MovM_RADIO_ID" class="form-check-label">Modificación</label>
            </div>
            <div class="form-check">
                <input name="LsHumaAdi[INDEX_LISTA].Movimiento" id="MovB_RADIO_ID" class="form-check-input" type="radio" value="SBaja">
                <label for="MovB_RADIO_ID" class="form-check-label">Baja</label>
            </div>
        </div>

        <hr class="my-4">

        <div class="d-flex flex-column gap-1">
            <div class="d-flex">
                <label class="col-4 col-form-label">Clave Dependencia</label>
