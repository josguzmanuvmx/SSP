<!-- Modal confirmar salir, borrador, descartar y guardar cambios -->
<div class="modal fade" id="modalConfirmarSalida" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0">
