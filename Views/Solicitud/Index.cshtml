            </div>
            <div class="d-flex">
                <label class="col-4 col-form-label">Clave de Programa</label>
                <div class="col-8">
                    <input name="LsHumaAdi[INDEX_LISTA].NProgClv" type="text" class="txtProgClv form-control bg-transparent" placeholder="Programa" required>
