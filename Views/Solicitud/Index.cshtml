                    <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> Cambios pendientes
                </h5>
            </div>
            <div class="modal-body py-3">
                <p class="mb-0 fs-5 text-center">
                    Tienes cambios sin guardar.<br>
                    ¿Qué deseas hacer antes de salir?
                </p>
            </div>
            <div class="modal-footer border-top-0 flex-column gap-2 pb-4">

                <button type="button" id="btn-guardar-borrador" class="btn btn-primary w-100 rounded-pill py-2">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Guardar como borrador
                </button>

                <button type="button" id="btn-descartar" class="btn btn-outline-danger w-100 rounded-pill py-2">
                    <i class="fa-solid fa-trash me-2"></i> Descartar cambios
                </button>

                <button type="button" class="btn btn-link text-decoration-none text-secondary w-100" data-bs-dismiss="modal">
                    Cancelar y seguir editando
                </button>
            </div>
        </div>
    </div>
</div>

